.gal{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:170px;gap:14px}
.g{border-radius:20px;overflow:hidden;position:relative;display:flex;align-items:flex-end;padding:16px;color:#fff;font-weight:500;transition:.5s;cursor:default}
.g:hover{transform:scale(1.04);z-index:2;box-shadow:0 20px 50px #0006}
.g svg{position:absolute;inset:0;width:100%;height:100%;opacity:.9;transition:.8s}.g:hover svg{transform:scale(1.15) rotate(2deg)}
.g span{position:relative;text-shadow:0 2px 8px #0008}
.g1{grid-column:span 2;grid-row:span 2;background:linear-gradient(135deg,#1c3a73,#3b6fd8)}.g2{background:linear-gradient(135deg,#c2873a,#f1d27f)}.g3{background:linear-gradient(135deg,#1f7a5a,#6fd1a0)}.g4{grid-column:span 2;background:linear-gradient(135deg,#7a2f6b,#e08bb8)}.g5{background:linear-gradient(135deg,#0b1b3a,#4a5f94)}
.note{text-align:center;color:var(--mut);font-size:.8rem;margin-top:14px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px}
.c{background:var(--card);border-radius:22px;padding:30px;box-shadow:0 10px 40px #0b1b3a14;transition:.4s;transform-style:preserve-3d}
.c:hover{box-shadow:0 25px 60px #0b1b3a30}
.c i{font-style:normal;font-size:2rem;display:block;margin-bottom:12px}
.c h3{font-size:1.2rem;margin-bottom:12px}.c li{list-style:none;color:var(--mut);padding:5px 0 5px 22px;position:relative;font-size:.92rem}
.c li:before{content:"✦";position:absolute;left:0;color:var(--gold);font-size:.7rem;top:9px}
.pills{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
.pills span{background:var(--card);padding:12px 24px;border-radius:50px;box-shadow:0 6px 20px #0b1b3a14;transition:.3s;font-size:.92rem}
.pills span:hover{background:var(--navy);color:#fff;transform:translateY(-5px)}
.cta{background:linear-gradient(120deg,var(--navy),#1c3a73);color:#fff;text-align:center;border-radius:30px;margin:0 6%;padding:60px 20px;max-width:none}
.cta h2{font-size:clamp(1.6rem,4vw,2.6rem);margin-bottom:12px}.cta p{opacity:.8;margin-bottom:26px}
.ct{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}
.ct div{background:var(--card);padding:28px;border-radius:20px;text-align:center;box-shadow:0 10px 40px #0b1b3a14}
.ct b{display:block;color:var(--gold);margin-bottom:6px}.ct a{color:var(--ink);text-decoration:none}
footer{background:var(--navy);color:#fff9;text-align:center;padding:30px 6%;margin-top:80px;font-size:.85rem}
#fab{position:fixed;right:20px;bottom:calc(20px + env(safe-area-inset-bottom,0px));z-index:40}
#md{position:fixed;inset:0;background:#050b1acc;backdrop-filter:blur(6px);z-index:90;display:none;place-items:center;padding:3%}
#md.on{display:grid}
.box{background:var(--card);width:min(760px,100%);height:min(88vh,100%);border-radius:24px;overflow:hidden;display:flex;flex-direction:column;animation:pop .5s cubic-bezier(.2,.9,.3,1.2)}
@keyframes pop{from{transform:scale(.8) translateY(40px);opacity:0}}
.mh{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;background:var(--navy);color:#fff}
.mh button{background:none;border:0;color:#fff;font-size:1.6rem;cursor:pointer}
.mh a{color:var(--gold);font-size:.8rem;margin-right:14px}
.box iframe{flex:1;border:0;width:100%;background:#fff}
@media(max-width:800px){nav ul{display:none}.about{grid-template-columns:1fr}.gal{grid-template-columns:1fr 1fr}.g1,.g4{grid-column:span 2}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
