<script>
var md=document.getElementById('md'),fr=document.getElementById('fr');
function openF(){if(!fr.src)fr.src='https://forms.gle/NUx6xvxEnPnjcbLd6';md.classList.add('on')}
function closeF(){md.classList.remove('on')}
md.onclick=function(e){if(e.target===md)closeF()};
addEventListener('load',function(){setTimeout(function(){document.getElementById('pre').classList.add('off')},700)});
var nav=document.getElementById('nav');addEventListener('scroll',function(){nav.classList.toggle('s',scrollY>40)});
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');e.target.querySelectorAll('[data-n]').forEach(count);io.unobserve(e.target)}})},{threshold:.15});
document.querySelectorAll('.rv').forEach(function(x,i){x.style.transitionDelay=(i%3)*.12+'s';io.observe(x)});
function count(el){var n=+el.dataset.n,t=0;(function s(){t+=n/60;if(t>=n){el.textContent=n;return}el.textContent=Math.floor(t);requestAnimationFrame(s)})()}
document.querySelectorAll('.c').forEach(function(c){c.addEventListener('mousemove',function(e){var r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;c.style.transform='perspective(700px) rotateY('+x*10+'deg) rotateX('+-y*10+'deg) translateY(-6px)'});c.addEventListener('mouseleave',function(){c.style.transform=''})});
addEventListener('mousemove',function(e){var x=e.clientX/innerWidth-.5,y=e.clientY/innerHeight-.5;document.querySelector('.o1').style.marginRight=x*40+'px';document.querySelector('.o2').style.marginTop=y*40+'px'});
