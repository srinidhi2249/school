<style>
:root{--navy:#0b1b3a;--navy2:#13294f;--gold:#d4a84b;--cream:#faf6ec;--ink:#1c2540;--mut:#5d6785;--card:#fff;--bg:var(--cream);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0a1226;--card:#121d38;--ink:#eef0f7;--mut:#a3adc9}}
:root[data-theme="dark"]{--bg:#0a1226;--card:#121d38;--ink:#eef0f7;--mut:#a3adc9}
*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth;scroll-padding-top:70px}
body{font-family:Poppins,system-ui,sans-serif;background:var(--bg);color:var(--ink);overflow-x:hidden}
h1,h2,h3{font-family:'Playfair Display',Georgia,serif}
#pre{position:fixed;inset:0;background:var(--navy);z-index:99;display:grid;place-items:center;transition:opacity .8s,visibility .8s}
#pre img{width:110px;border-radius:50%;background:#fff;padding:6px;animation:pulse 1.4s infinite}
#pre.off{opacity:0;visibility:hidden}
@keyframes pulse{50%{transform:scale(1.12);box-shadow:0 0 0 18px #d4a84b33}}
nav{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:12px 5%;padding-top:calc(12px + env(safe-area-inset-top,0px));transition:.4s;color:#fff}
nav.s{background:#0b1b3aee;backdrop-filter:blur(12px);box-shadow:0 8px 30px #0004}
nav b{display:flex;align-items:center;gap:10px;font-family:'Playfair Display',serif;font-size:1.05rem}
nav b img{width:42px;height:42px;border-radius:50%;background:#fff;padding:2px}
nav ul{display:flex;gap:26px;list-style:none;font-size:.88rem}
nav a{color:inherit;text-decoration:none;opacity:.85;position:relative}
nav ul a:after{content:"";position:absolute;left:0;bottom:-4px;height:2px;width:0;background:var(--gold);transition:.3s}
nav ul a:hover:after{width:100%}
.btn{display:inline-block;border:0;cursor:pointer;font:600 .9rem Poppins;padding:13px 28px;border-radius:50px;background:linear-gradient(120deg,#d4a84b,#f1d27f,#d4a84b);background-size:200%;color:#0b1b3a;text-decoration:none;transition:.4s;box-shadow:0 8px 24px #d4a84b55}
.btn:hover{background-position:100% 0;transform:translateY(-3px) scale(1.04)}
.btn.o{background:none;color:#fff;border:1.5px solid #fff8;box-shadow:none}
.hero{min-height:100vh;min-height:100svh;background:radial-gradient(circle at 20% 20%,#1c3a73,var(--navy) 60%);color:#fff;display:grid;place-items:center;text-align:center;padding:120px 6% 80px;position:relative;overflow:hidden}
.orb{position:absolute;border-radius:50%;filter:blur(60px);opacity:.35;animation:fl 12s ease-in-out infinite}
.o1{width:340px;height:340px;background:#d4a84b;top:-80px;right:-60px}.o2{width:300px;height:300px;background:#3b6fd8;bottom:-60px;left:-60px;animation-delay:-5s}
@keyframes fl{50%{transform:translate(40px,50px) scale(1.15)}}
.hero .in{position:relative;max-width:820px}
.logo{width:150px;height:150px;border-radius:50%;background:#fff;padding:8px;margin-bottom:24px;box-shadow:0 0 0 6px #d4a84b66,0 20px 60px #0008;animation:fl2 6s ease-in-out infinite}
