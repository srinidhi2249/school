.tag{letter-spacing:.35em;font-size:.75rem;color:var(--gold);text-transform:uppercase}
.hero h1{font-size:clamp(2.2rem,6vw,4.6rem);line-height:1.1;margin:14px 0;background:linear-gradient(90deg,#fff,#f1d27f,#fff);background-size:200%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:sh 5s linear infinite}
